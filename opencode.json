{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "mcp": {
    "shopify": {
      "type": "local",
      "command": ["npx", "-y", "@shopify/dev-mcp@latest"]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "cve-search": {
      "type": "local",
      "command": ["uv", "--directory", "/Users/{env:USER}/.local/share/mcp/cve-search_mcp", "run", "main.py"]
    },
    "primevue": {
        "type": "local",
        "command": ["npx", "-y", "@primevue/mcp"]
    },
    "pdf-reader": {
        "type": "local",
        "command": ["npx", "-y", "@fabriqa.ai/pdf-reader-mcp"]
    },
    "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp@latest"]
    }
  },
  "agent": {
    "implementer": {
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "shopify": true,
        "primevue": true,
        "github": true
      }
    },
    "test-runner": {
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "chrome-devtools": true
      }
    },
    "explorer": {
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "shopify": true,
        "primevue": true,
        "github": true
      }
    },
    "researcher": {
      "tools": {
        "read": true,
        "webfetch": true,
        "context7": true,
        "cve-search": true,
        "pdf-reader": true
      }
    },
    "general": {
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "todowrite": true,
        "webfetch": true,
        "task": true,
        "shopify": true,
        "primevue": true,
        "github": true,
        "chrome-devtools": true,
        "cve-search": true,
        "pdf-reader": true,
        "context7": true
      }
    }
  }
}
